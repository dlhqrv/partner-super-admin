# Where p-Back runs (Vite proxy target for /admin in dev). Must match p-Back PORT in p-Back/.env
VITE_API_PROXY_TARGET=http://127.0.0.1:4000

# Same Supabase project as p-Back (Dashboard → Settings → API). Use the anon public key only.
# Enables Audit log “Live” via Realtime on public.audit_logs (add table to supabase_realtime publication).
# If unset, the Audit page falls back to HTTP polling. audit_logs has no RLS in this schema; treat the anon key as internal-only or add RLS + auth before exposing broadly.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
